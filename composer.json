{
  "name": "svinx/console",
  "description": "A small fluent PHP CLI framework.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1"
  },
  "homepage": "https://github.com/svinx-org/console",
  "authors": [
    {
      "name": "EORBAH",
      "email": "eor.bah545@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/svinx-org/console/issues",
    "source": "https://github.com/svinx-org/console"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Svinx\\Console\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Svinx\\Console\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/svinx-console"
  ],
  "scripts": {
    "test": "phpunit",
    "demo": "svinx-console",
    "lint": "php -l src/Console.php && php -l src/Command.php && php -l src/Option.php && php -l src/Argument.php && php -l src/Input.php && php -l src/Output.php && php -l src/Parser.php"
  }
}